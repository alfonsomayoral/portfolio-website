{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "portfolio-website-.*\\.vercel\\.app"
        }
      ],
      "destination": "https://alfonsomayoral.vercel.app/:path*",
      "permanent": true
    },
    { "source": "/trading", "destination": "/work", "permanent": true },
    { "source": "/trading/", "destination": "/work/", "permanent": true },
    { "source": "/trading/:path*", "destination": "/work/:path*", "permanent": true },
    { "source": "/capital", "destination": "/education", "permanent": true },
    { "source": "/capital/", "destination": "/education/", "permanent": true },
    { "source": "/capital/:path*", "destination": "/education/:path*", "permanent": true },
    { "source": "/maritime", "destination": "/projects", "permanent": true },
    { "source": "/maritime/", "destination": "/projects/", "permanent": true },
    { "source": "/maritime/:path*", "destination": "/projects/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/work", "destination": "/trading/" },
    { "source": "/work/", "destination": "/trading/" },
    { "source": "/education", "destination": "/capital/" },
    { "source": "/education/", "destination": "/capital/" },
    { "source": "/projects", "destination": "/maritime/" },
    { "source": "/projects/", "destination": "/maritime/" }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/textures/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/sounds/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/libs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/neural.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
